# Browser-side fetch URL for the api service.
#
# Standalone dev (no compose): http://localhost:3001
# Panel preview proxy:         http://api.localhost
# Production:                  https://api.example.com
#
# Under compose, leave this UNSET in apps/web/.env — the workspace
# `.env` (root) drives docker-compose.yml's NEXT_PUBLIC_API_URL fallback,
# which resolves to http://localhost:${API_PORT} per worktree
# automatically. See root .env.example for the full mode matrix.
NEXT_PUBLIC_API_URL=http://localhost:3001
