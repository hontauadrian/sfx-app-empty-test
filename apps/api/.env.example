# API service env. Inside compose, the actual values come from the workspace
# .env (POSTGRES_*) merged through docker-compose.yml. This file documents
# the standalone-dev layout (no compose).
#
# Replace the credentials portion when you change POSTGRES_USER / DB / etc
# in the workspace .env so they stay in sync. The compose `DATABASE_URL`
# already interpolates from the same vars and survives any rename.
DATABASE_URL=postgresql://sfx:sfx@localhost:5432/sfx_db
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OAUTH_ISSUER_URL=http://keycloak.localtest.me:9080/realms/sfx-panel
OAUTH_JWKS_URL=http://keycloak.localtest.me:9080/realms/sfx-panel/protocol/openid-connect/certs
OAUTH_API_CLIENT_ID=sfx-app-dev-api
OAUTH_AUDIENCE=sfx-app-dev-api
PORT=3001
NODE_ENV=development

# CORS allowlist (csv). Empty/unset = permissive (dev-friendly).
# Standalone dev:  http://localhost:3000
# Panel preview:   http://app.localhost
# Production:      https://app.example.com,https://example.com
WEB_ORIGIN=
