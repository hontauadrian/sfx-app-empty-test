{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "baseUrl": "./",
    "paths": {},
    "target": "es2022",
    "keepClassNames": true
  },
  "module": {
    "type": "commonjs",
    "strictMode": true,
    "noInterop": false
  },
  "minify": false
}
