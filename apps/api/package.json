{
  "name": "@sfx/api",
  "version": "0.0.0",
  "description": "SFX webapp boilerplate HTTP contract",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter \"@sfx/domain\" --filter \"@sfx/shared\" --filter \"@sfx/validation\" --filter \"@sfx/database\" run build && nest start -b swc --watch",
    "build": "nest build",
    "openapi:dump": "pnpm exec tsx scripts/dump-openapi.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config test/vitest-e2e.config.ts",
    "test:integration": "vitest run --config test/vitest-integration.config.ts --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.2.7",
    "@nestjs/throttler": "6.4.0",
    "@sfx/database": "workspace:*",
    "@sfx/domain": "workspace:*",
    "@sfx/shared": "workspace:*",
    "@sfx/validation": "workspace:*",
    "class-transformer": "0.5.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.13.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.0",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
