#!/usr/bin/env bash
# Runs after every successful `git merge`. If the merge touched the mulch
# config file, run `mulch sync` to re-derive the domain list from the
# expertise jsonl files and commit the result. This corrects for the
# `merge=ours` driver silently dropping domain additions from the agent
# branch.

set -euo pipefail

MULCH_CONFIG=".mulch/mulch.config.yaml"

# Only react when both sides of the merge had different content for the
# config file — that's the exact case where the `merge=ours` driver may
# have dropped feature-branch domain additions. Comparing HEAD^1 vs HEAD^2
# catches this even when the merge commit's content equals main's pre-merge
# version (which makes ORIG_HEAD..HEAD diff empty).
#
# Fast-forward merges have no HEAD^2 and can't drop content, so skip them.
if ! git rev-parse --verify -q HEAD^2 >/dev/null; then
  exit 0
fi
if ! git diff --name-only HEAD^1 HEAD^2 -- "$MULCH_CONFIG" | grep -q .; then
  exit 0
fi

# mulch must exist; skip silently if not installed (e.g. fresh clone without deps).
if ! command -v mulch >/dev/null 2>&1; then
  exit 0
fi

echo "[post-merge] reconciling $MULCH_CONFIG via mulch sync"
# --no-validate avoids aborting on pre-existing issues unrelated to the merge.
mulch sync --message "chore(mulch): post-merge reconcile" --no-validate || {
  echo "[post-merge] mulch sync failed (non-fatal) — manual sync may be needed"
  exit 0
}
