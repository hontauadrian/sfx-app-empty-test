# Compose env — copy to `.env` for any non-default values.
# `scripts/stack-up-docker.sh` sources `.env` automatically so per-worker
# stacks see the same DB credentials as the primary.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db
JWT_SECRET=dev-secret-minimum-16-chars

# =============================================================================
# Browser/api URL resolution — single source of truth via compose `:-` fallbacks.
#
# Worktree dev (overstory worker, default): leave NEXT_PUBLIC_API_URL and
#   WEB_ORIGIN unset. `scripts/stack-up-docker.sh` exports per-worker
#   API_PORT + NEXT_PORT (hash-derived, no collisions); compose fills:
#     NEXT_PUBLIC_API_URL = http://localhost:${API_PORT}
#     WEB_ORIGIN          = http://localhost:${NEXT_PORT}
#
# Main branch under panel preview (panel nginx routes app./api. subdomains):
#   NEXT_PUBLIC_API_URL=http://api.localhost
#   WEB_ORIGIN=http://app.localhost
#
# Production (real domain + TLS):
#   NEXT_PUBLIC_API_URL=https://api.example.com
#   WEB_ORIGIN=https://app.example.com,https://example.com   # csv allowed
# =============================================================================
NEXT_PUBLIC_API_URL=
WEB_ORIGIN=
