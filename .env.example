# Compose env — copy to `.env` for any non-default values.
# `scripts/stack-up-docker.sh` sources `.env` automatically so per-worker
# stacks see the same DB credentials as the primary.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db
JWT_SECRET=dev-secret-minimum-16-chars

# =============================================================================
# Browser/api URL resolution — single source of truth via compose `:-` fallbacks.
#
# OAuth dev (default): leave NEXT_PUBLIC_API_URL unset/empty and open the app
#   through oauth2-proxy at http://app.localtest.me:${APP_PROXY_PORT:-4181}.
#   Browser API calls stay same-origin under /api/v1/* so oauth2-proxy can
#   forward the Keycloak access token to the API.
#
# Direct web/API debugging: set NEXT_PUBLIC_API_URL and WEB_ORIGIN explicitly:
#   NEXT_PUBLIC_API_URL=http://localhost:${API_PORT}
#   WEB_ORIGIN=http://localhost:${NEXT_PORT}
#
# Production (real domain + TLS):
#   NEXT_PUBLIC_API_URL=
#   WEB_ORIGIN=https://app.example.com,https://example.com   # csv allowed
# =============================================================================
NEXT_PUBLIC_API_URL=
WEB_ORIGIN=

# Local OAuth defaults. SFX Panel/Foreman owns real client/secret provisioning.
APP_PROXY_PORT=4181
OAUTH_ISSUER_URL=http://keycloak.localtest.me:9080/realms/sfx-panel
OAUTH_JWKS_URL=http://keycloak.localtest.me:9080/realms/sfx-panel/protocol/openid-connect/certs
OAUTH_API_CLIENT_ID=sfx-app-dev-api
OAUTH_AUDIENCE=sfx-app-dev-api
OAUTH2_PROXY_CLIENT_ID=sfx-app-dev-proxy
OAUTH2_PROXY_CLIENT_SECRET=dev-generated-app-proxy-secret
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdef0123456789abcdef
OAUTH2_PROXY_REDIRECT_URL=http://app.localtest.me:4181/oauth2/callback
OAUTH2_PROXY_COOKIE_DOMAIN=app.localtest.me
OAUTH2_PROXY_COOKIE_SECURE=false
