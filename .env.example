# Compose env — copy to `.env` for any non-default values.
# `scripts/stack-up-docker.sh` sources `.env` automatically so per-worker
# stacks see the same DB credentials as the primary.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db
JWT_SECRET=dev-secret-minimum-16-chars

# =============================================================================
# Browser/api URL resolution — single source of truth via compose `:-` fallbacks.
#
# OAuth dev (default): leave NEXT_PUBLIC_API_URL unset/empty and open the app
#   through oauth2-proxy at http://app.localtest.me:${APP_PROXY_PORT:-4181}.
#   Browser API calls stay same-origin under /api/v1/* so oauth2-proxy can
#   forward the Keycloak access token to the API.
#
# Direct web/API debugging: set NEXT_PUBLIC_API_URL and WEB_ORIGIN explicitly:
#   NEXT_PUBLIC_API_URL=http://localhost:${API_PORT}
#   WEB_ORIGIN=http://localhost:${NEXT_PORT}
#
# Production (real domain + TLS):
#   NEXT_PUBLIC_API_URL=
#   WEB_ORIGIN=https://app.example.com,https://example.com   # csv allowed
# =============================================================================
NEXT_PUBLIC_API_URL=
WEB_ORIGIN=

# Local OAuth defaults. Generated apps run their own dev Keycloak and seed it
# from infra/keycloak/manifest.json + infra/keycloak/dev-seed.json.
APP_PROXY_PORT=4181
KEYCLOAK_PORT=9080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# OAUTH_ISSUER_URL / OAUTH_JWKS_URL: single-hostname strategy.
#
# Both browser users (primary `app-dev-host` stack) and QA probe agents
# running INSIDE the SFX panel container (worker stacks) must reach
# Keycloak via the SAME hostname. Keycloak `start-dev --hostname-strict=false`
# mints tokens with iss=<request-host>, and the api validates iss against
# `OAUTH_ISSUER_URL`. Mismatched hostnames produce 401 "Invalid token issuer"
# on every authenticated request.
#
# `keycloak.localtest.me` is the only hostname that works from all three:
#   1. Real browsers (Chrome, Safari, Firefox) — `*.localtest.me` is a public
#      wildcard DNS entry resolving to 127.0.0.1, so the developer reaches
#      Keycloak via the host's published port without /etc/hosts edits.
#   2. The api / app-oauth2-proxy containers — declare
#      `keycloak.localtest.me:host-gateway` in `extra_hosts` (see
#      docker-compose.yml) so the same hostname resolves to the host gateway
#      from inside Docker.
#   3. The SFX panel container running `pnpm probe:smoke` — declares the
#      same `extra_hosts` entry in `sfx-team-panel/docker-compose.yml`.
OAUTH_ISSUER_URL=http://keycloak.localtest.me:9080/realms/sfx-webapp-boilerplate
OAUTH_JWKS_URL=http://keycloak.localtest.me:9080/realms/sfx-webapp-boilerplate/protocol/openid-connect/certs
OAUTH_API_CLIENT_ID=sfx-webapp-boilerplate-dev-api
OAUTH_AUDIENCE=sfx-webapp-boilerplate-dev-api
OAUTH2_PROXY_CLIENT_ID=sfx-webapp-boilerplate-dev-proxy
OAUTH2_PROXY_CLIENT_SECRET=dev-generated-app-proxy-secret
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdef0123456789abcdef
OAUTH2_PROXY_REDIRECT_URL=http://app.localtest.me:4181/oauth2/callback
OAUTH2_PROXY_COOKIE_SECURE=false
