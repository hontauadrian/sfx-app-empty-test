      }
    ],
    "bun": [
      {
        "_no_eval_flags": true
      }
    ],
    "bash": [
      {
        "_no_inline_scripts": true
      }
    ],
    "sh": [
      {
        "_no_inline_scripts": true
      }
    ],
    "curl": [
      {
        "_host_allowlist": [
          "localhost",
          "127.0.0.1",
          "::1"
        ]
      }
    ]
