{
  "openapi": "3.0.0",
  "info": { "title": "minimal", "version": "1.0" },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness probe",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["users"],
        "summary": "Fetch user by id",
        "security": [{ "bearer": [] }],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Missing" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" }
    }
  }
}
