	"hooks": {
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-ignore-for-changed-paths.js"
					}
				]
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/probe-covers-diff.js"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/bash-allowlist.js"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-hook-introspection.js"
					}
				]
			},
			{
				"matcher": "mcp__.*",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-hook-introspection.js"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-hook-author.js"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-node-modules-write.js"
					}
				]
			},
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-generated-write.js"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-co-mingled-overlay-commit.js"
					}
				]
			},
			{
				"matcher": "Read|Edit|Write|Glob|Grep|MultiEdit|NotebookEdit|NotebookRead",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/no-hook-introspection-fs.js"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/flows-pre-sling.js"
					}
				]
			}
		]
	},
	"enabledMcpjsonServers": [
		"playwright"
	]
}
