{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://overstory.dev/schemas/matrix.json",
  "type": "object",
  "required": ["version", "projectDir", "detectedFrameworks", "bootPlan", "pages", "apiEndpoints"],
  "properties": {
    "version": { "const": "1" },
    "generatedAt": { "type": "string" },
    "projectDir": { "type": "string" },
    "scope": { "enum": ["session", "full"] },

    "detectedFrameworks": {
      "type": "object",
      "properties": {
        "web": { "type": "array", "items": { "enum": ["next","nuxt","vite-react","sveltekit","remix","astro","angular","solid","unknown"] } },
        "api": { "type": "array", "items": { "enum": ["nest","express","fastify","hono","trpc","elysia","koa","unknown"] } },
        "monorepo": { "enum": ["turbo","nx","lerna","pnpm-workspace","yarn-workspace","none"] },
        "auth": { "type": "array", "items": { "enum": ["jwt","next-cookie","session-cookie","supabase","clerk","auth.js","unknown"] } },
        "appRouter": { "type": "boolean" }
      }
    },

    "bootPlan": {
      "type": "object",
      "required": ["driver", "ports"],
      "properties": {
        "driver":     { "enum": ["worktree-stack","package-json","docker-compose","turbo","framework-defaults","none"] },
        "driverPath": { "type": ["string", "null"] },
        "startCmd":   { "type": ["string", "null"] },
        "stopCmd":    { "type": ["string", "null"] },
        "portsCmd":   { "type": ["string", "null"] },
        "stackFile":  { "type": ["string", "null"] },
        "ports":      { "type": "object", "additionalProperties": { "type": "integer" } },
        "envFiles":   { "type": "array", "items": { "type": "string" } },
        "alreadyRunning": { "type": "boolean" }
      }
    },

    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "route", "framework", "guard"],
        "properties": {
          "file":               { "type": "string" },
          "route":              { "type": "string" },
          "routeParams":        { "type": "array", "items": { "type": "string" } },
          "framework":          { "enum": ["next-app","next-pages","nuxt","sveltekit","remix","astro","angular","vite-react","solid"] },
          "guard":              { "enum": ["public","authenticated","optional-auth","unknown"] },
          "unauthRedirect":     { "type": ["string", "null"] },
          "postLoginRedirect":  { "type": ["string", "null"] },
          "tokens":             { "type": "array", "items": { "type": "string" } },
          "mustNotContain":     { "type": "array", "items": { "type": "string" } },
          "changed":            { "type": "boolean" }
        }
      }
    },

    "apiEndpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "method", "path", "framework", "guard"],
        "properties": {
          "file":            { "type": "string" },
          "method":          { "enum": ["GET","POST","PUT","PATCH","DELETE","OPTIONS","HEAD","ALL"] },
          "path":            { "type": "string" },
          "framework":       { "enum": ["nest","express","fastify","hono","trpc","elysia","koa","next-api","nuxt-api","sveltekit-api","astro-api"] },
          "guard":           { "enum": ["public","authenticated","optional-auth","unknown"] },
          "inputSchemaRef":  { "type": ["string", "object", "null"] },
          "sampleValid":     {},
          "sampleInvalid":   { "type": "array" },
          "successStatus":   { "type": "integer" },
          "errorStatuses":   { "type": "array", "items": { "type": "integer" } },
          "changed":         { "type": "boolean" },

          "zodContract": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["schemaRef", "fields", "sampleValid"],
                "properties": {
                  "schemaRef": { "type": "string" },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "type", "required", "constraints", "samples"],
                      "properties": {
                        "name":        { "type": "string" },
                        "type":        { "enum": ["string","number","boolean","array","object","enum","literal","union","unknown"] },
                        "required":    { "type": "boolean" },
                        "constraints": { "type": "object" },
                        "samples": {
                          "type": "object",
                          "properties": {
                            "valid": {},
                            "invalidators": { "type": "array" }
                          }
                        }
                      }
                    }
                  },
                  "sampleValid":  { "type": "object" },
                  "diagnostics":  { "type": "array", "items": { "type": "string" } }
                }
              }
            ]
          },

          "queryContract": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["schemaRef", "fields", "sampleValid"],
                "properties": {
                  "schemaRef": { "type": "string" },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "type", "required", "constraints", "samples"],
                      "properties": {
                        "name":        { "type": "string" },
                        "type":        { "enum": ["string","number","boolean","array","object","enum","literal","union","unknown"] },
                        "required":    { "type": "boolean" },
                        "constraints": { "type": "object" },
                        "samples": {
                          "type": "object",
                          "properties": {
                            "valid": {},
                            "invalidators": { "type": "array" }
                          }
                        }
                      }
                    }
                  },
                  "sampleValid":  { "type": "object" },
                  "diagnostics":  { "type": "array", "items": { "type": "string" } }
                }
              }
            ]
          },

          "authDecorators": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "authRequired":  { "type": "boolean" },
                  "isPublic":      { "type": "boolean" },
                  "guards":        { "type": "array", "items": { "type": "string" } },
                  "rolesRequired": { "type": "array", "items": { "type": "string" } },
                  "bearerAuth":    { "type": "boolean" }
                }
              }
            ]
          },

          "swaggerDeclared": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "tags":     { "type": "array", "items": { "type": "string" } },
                  "statuses": { "type": "array", "items": { "type": "integer" } }
                }
              }
            ]
          }
        }
      }
    },

    "forms":      { "type": "array" },
    "middleware": { "type": "array" },

    "authDetection": {
      "type": "object",
      "properties": {
        "loginSurface":          { "type": ["string", "null"] },
        "registerSurface":       { "type": ["string", "null"] },
        "logoutSurface":         { "type": ["string", "null"] },
        "sessionMechanism":      { "enum": ["jwt-in-header","jwt-in-cookie","session-cookie","supabase","clerk","auth.js","unknown"] },
        "tokenStorage":          { "enum": ["localStorage","cookie","zustand-memory","zustand-persist","redux-persist","none","unknown"] },
        "persistsAcrossRefresh": { "type": "boolean" }
      }
    },

    "diagnostics": {
      "type": "object",
      "properties": {
        "missingGuardHeaders":         { "type": "array", "items": { "type": "string" } },
        "pagesProtectedByConvention":  { "type": "array", "items": { "type": "string" } },
        "unreachablePages":            { "type": "array", "items": { "type": "string" } },
        "orphanEndpoints":             { "type": "array", "items": { "type": "string" } },
        "unknownFrameworks":           { "type": "array", "items": { "type": "string" } },
        "detectorErrors":              { "type": "array" }
      }
    },

    "cookieFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "issuers", "consumers", "clearers", "rotators", "attrs", "diagnostics"],
        "properties": {
          "name":  { "type": "string" },
          "role":  { "type": ["string", "null"], "enum": [
            "refresh-token", "session", "csrf-double-submit", "oauth-state",
            "tenant-scope", "locale", "theme", "feature-flag", "custom", null
          ]},
          "issuers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operationId", "path", "method"],
              "properties": {
                "operationId":        { "type": ["string", "null"] },
                "path":               { "type": "string" },
                "method":             { "type": "string" },
                "requestBodyExample": {}
              }
            }
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operationId", "path", "method"],
              "properties": {
                "operationId": { "type": ["string", "null"] },
                "path":        { "type": "string" },
                "method":      { "type": "string" },
                "headerEcho":  { "type": "string" },
                "valueSubstitutions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["cookieName", "target"],
                    "properties": {
                      "cookieName": { "type": "string" },
                      "target": {
                        "type": "object",
                        "required": ["in", "name"],
                        "properties": {
                          "in":   { "enum": ["header", "query", "body"] },
                          "name": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "clearers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operationId", "path", "method"],
              "properties": {
                "operationId": { "type": ["string", "null"] },
                "path":        { "type": "string" },
                "method":      { "type": "string" }
              }
            }
          },
          "rotators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operationId", "path", "method"],
              "properties": {
                "operationId": { "type": ["string", "null"] },
                "path":        { "type": "string" },
                "method":      { "type": "string" }
              }
            }
          },
          "attrs": { "type": "object" },
          "securitySchemeRef": { "type": ["string", "null"] },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "level"],
              "properties": {
                "code":    { "type": "string" },
                "level":   { "enum": ["error", "warn"] },
                "details": { "type": "object" }
              }
            }
          }
        }
      }
    },

    "manifest": {
      "type": "object",
      "properties": {
        "compiledPresent": { "type": "boolean" },
        "overlayPresent":  { "type": "boolean" },
        "overlayCoverage": { "enum": ["partial","complete",null] }
      }
    }
  }
}
