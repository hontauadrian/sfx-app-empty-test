{
  "version": 1,
  "task_id": "task-002",
  "owns": [
    {
      "resource": "child-resource"
    }
  ],
  "extends": [
    {
      "resource": "parent-resource"
    },
    {
      "actor": "actor-A"
    },
    {
      "actor": "actor-B"
    },
    {
      "actor": "anonymous"
    }
  ],
  "resources": [
    {
      "name": "child-resource",
      "create": {
        "method": "POST",
        "path": "/api/v1/parent/${parent-resource.id}/child",
        "bodyKind": "multipart",
        "body": []
      },
      "capture": {
        "bindings": {
          "id": "$.id"
        }
      },
      "parents": [
        "parent-resource"
      ],
      "multipartCreate": {
        "parts": [
          {
            "name": "avatar",
            "fixtureRef": "avatar.png",
            "mimeType": "image/png"
          },
          {
            "name": "name"
          }
        ]
      }
    }
  ],
  "special_flows": [
    {
      "id": "task-002:upload",
      "contract": {
        "kind": "http",
        "source": "plan-task-002 §1"
      },
      "setup": [
        {
          "create": "parent-resource",
          "by": "actor-A",
          "capture": "parent-id"
        }
      ],
      "steps": [
        {
          "kind": "api",
          "stepId": "upload",
          "transport": "http",
          "method": "POST",
          "path": "/api/v1/parent/${parent-resource.id}/child",
          "bodyKind": "multipart",
          "multipart": [
            {
              "name": "name",
              "value": "child-1"
            },
            {
              "name": "avatar",
              "file": {
                "fixtureRef": "avatar.png",
                "mimeType": "image/png",
                "filename": "avatar.png"
              }
            }
          ]
        },
        {
          "kind": "expect",
          "status": 201,
          "bodyShape": {
            "contains": [
              {
                "$.kind": "child"
              }
            ]
          },
          "headerHas": {
            "Content-Type": {
              "matches": "application/json.*"
            }
          }
        }
      ]
    },
    {
      "id": "task-002:poll-async",
      "contract": {
        "kind": "http",
        "source": "plan-task-002 §2"
      },
      "steps": [
        {
          "kind": "api",
          "transport": "http",
          "method": "POST",
          "path": "/api/v1/parent/${parent-resource.id}/child/async"
        },
        {
          "kind": "expect",
          "status": 202
        },
        {
          "kind": "capture",
          "bindings": {
            "jobId": "$.jobId"
          }
        },
        {
          "kind": "poll",
          "request": {
            "method": "GET",
            "path": "/api/v1/jobs/${jobId}"
          },
          "whileStatus": [
            202
          ],
          "intervalMs": 250,
          "timeoutMs": 5000,
          "finalExpect": {
            "status": 200,
            "bodyHas": {
              "$.state": "complete"
            }
          }
        }
      ],
      "coverageTemplate": "async-poll-to-complete"
    },
    {
      "id": "task-002:cookie-roundtrip",
      "contract": {
        "kind": "http",
        "source": "plan-task-002 §3"
      },
      "steps": [
        {
          "kind": "api",
          "transport": "http",
          "method": "POST",
          "path": "/api/v1/auth/login"
        },
        {
          "kind": "expect",
          "status": 200
        },
        {
          "kind": "capture-cookie",
          "name": "session",
          "binding": "session-cookie"
        },
        {
          "kind": "assert-cookie-attrs",
          "name": "session",
          "attrs": {
            "httpOnly": true,
            "secure": true,
            "sameSite": "Lax"
          }
        },
        {
          "kind": "replay-cookie-as-header",
          "name": "session",
          "header": "X-Session"
        },
        {
          "kind": "tamper-cookie",
          "name": "session",
          "with": "invalid-value"
        },
        {
          "kind": "omit-cookie",
          "name": "session"
        },
        {
          "kind": "assert-cookie-rotated",
          "name": "session"
        },
        {
          "kind": "assert-cookie-cleared",
          "name": "session"
        }
      ]
    },
    {
      "id": "task-002:parallel-and-matrix",
      "contract": {
        "kind": "http",
        "source": "plan-task-002 §4"
      },
      "steps": [
        {
          "kind": "parallel",
          "branches": [
            {
              "actor": "actor-A",
              "isolatedAuth": true,
              "steps": [
                {
                  "kind": "api",
                  "transport": "http",
                  "method": "POST",
                  "path": "/api/v1/parent"
                }
              ]
            },
            {
              "actor": "actor-B",
              "isolatedAuth": true,
              "steps": [
                {
                  "kind": "api",
                  "transport": "http",
                  "method": "POST",
                  "path": "/api/v1/parent"
                }
              ]
            }
          ],
          "aggregate": {
            "successCount": 1,
            "failureCount": 1,
            "statusCounts": {
              "201": 1,
              "409": 1
            }
          }
        },
        {
          "kind": "matrix",
          "axis": {
            "actor": [
              "actor-A",
              "actor-B"
            ]
          },
          "template": {
            "steps": [
              {
                "kind": "api",
                "transport": "http",
                "method": "GET",
                "path": "/api/v1/parent"
              }
            ]
          },
          "cells": [
            {
              "when": {
                "actor": "actor-A"
              },
              "expect": {
                "status": 200
              }
            },
            {
              "when": {
                "actor": "actor-B"
              },
              "expect": {
                "status": 200
              }
            }
          ]
        },
        {
          "kind": "assertBulk",
          "request": {
            "method": "POST",
            "path": "/api/v1/parent/bulk",
            "body": {
              "items": []
            }
          },
          "shape": "multi-status",
          "multiStatusCode": 207
        },
        {
          "kind": "assertIdempotent",
          "request": {
            "method": "POST",
            "path": "/api/v1/parent",
            "body": {
              "name": "idem"
            }
          },
          "keyHeader": "Idempotency-Key",
          "variant": "replay-same",
          "expectReplayStatus": 201
        },
        {
          "kind": "wait",
          "advanceMs": 60001
        },
        {
          "kind": "setAuth",
          "binding": "actor-A"
        },
        {
          "kind": "navigate",
          "to": "/home"
        },
        {
          "kind": "logout"
        },
        {
          "kind": "assertSideEffect",
          "decl": {
            "kind": "outbound-webhook",
            "polarity": "expected-absent",
            "description": "no webhook fires when bulk is empty",
            "verifiedBy": "http-probe"
          }
        }
      ]
    }
  ]
}
