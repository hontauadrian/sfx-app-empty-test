      "id": "sfx-webapp-boilerplate-72fd:voice-get-unauth-rejected",
      "description": "GET /api/v1/brands/:brandId/guidelines/voice without bearer is rejected with 401",
      "contract": {
        "kind": "http",
        "source": "spec-72fd §5 + spec-ba09 §5 J2 cross-cutting auth boundary",
        "endpoint": "GET /api/v1/brands/:brandId/guidelines/voice"
      },
      "steps": [
        { "kind": "setAuth", "binding": "anonymous" },
        { "kind": "api", "transport": "http", "method": "GET", "path": "/brands/clxxxbrand0000000099/guidelines/voice" },
        { "kind": "expect", "status": 401 }
      ]
    },
    {
      "id": "sfx-webapp-boilerplate-72fd:voice-get-non-admin-forbidden",
      "description": "GET /api/v1/brands/:brandId/guidelines/voice with viewer (non-admin, non-agent) is rejected with 403. At Chunk B, agent role is not yet wired — only admin reads pass.",
      "contract": {
        "kind": "http",
        "source": "spec-72fd §5 + spec-ba09 §5 J2 auth matrix",
        "endpoint": "GET /api/v1/brands/:brandId/guidelines/voice"
      },
      "steps": [
        { "kind": "setAuth", "binding": "viewer" },
        { "kind": "api", "transport": "http", "method": "GET", "path": "/brands/clxxxbrand0000000099/guidelines/voice" },
        { "kind": "expect", "status": 403 }
      ]
    },
    {
      "id": "sfx-webapp-boilerplate-72fd:voice-get-unknown-brand-404",
      "description": "GET /api/v1/brands/:brandId/guidelines/voice with admin + unknown brandId returns 404 via brand-existence guard",
      "contract": {
        "kind": "http",
        "source": "spec-72fd §5 Task B-B2 brand-exists.helper",
        "endpoint": "GET /api/v1/brands/:brandId/guidelines/voice"
      },
      "steps": [
        { "kind": "setAuth", "binding": "admin" },
        { "kind": "api", "transport": "http", "method": "GET", "path": "/brands/clxxxbrand0000000099/guidelines/voice" },
        { "kind": "expect", "status": 404 }
