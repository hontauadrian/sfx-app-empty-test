    {
      "id": "sfx-webapp-boilerplate-72fd:voice-put-admin-ok",
      "description": "PUT /api/v1/brands/:brandId/guidelines/voice with admin + valid body upserts and returns 200 with persisted envelope",
      "contract": {
        "kind": "http",
        "source": "spec-72fd §5 J2 happy-path persistence + spec-ba09 §5 J2",
        "endpoint": "PUT /api/v1/brands/:brandId/guidelines/voice"
      },
      "steps": [
        { "kind": "setAuth", "binding": "admin" },
        { "kind": "api", "transport": "http", "method": "POST", "path": "/brands", "body": { "name": "Voice Happy Brand" } },
        { "kind": "expect", "status": 201, "bodyHas": { "$.success": true } },
        { "kind": "capture", "bindings": { "createdBrandId": "$.data.id" } },
        {
          "kind": "api",
          "transport": "http",
          "method": "PUT",
          "path": "/brands/${createdBrandId}/guidelines/voice",
          "body": {
            "tone": "Warm, expert, never condescending",
            "preferredVocabulary": ["craft", "partner"],
            "restrictedVocabulary": ["cheap", "guarantee"],
            "messagingPillars": [{ "title": "Trust", "description": "We earn long-term partnerships." }],
            "writingStyleRules": "Use active voice. Avoid jargon.",
            "audienceRules": [{ "audience": "Designers", "rules": "Show work, link sources." }],
            "approvedExamples": [{ "phrase": "Crafted for clarity." }],
            "rejectedExamples": [{ "phrase": "Cheap promises.", "reason": "Restricted vocab + tone mismatch" }]
          }
        },
        {
          "kind": "expect",
          "status": 200,
          "bodyHas": {
            "$.success": true,
            "$.data.tone": "Warm, expert, never condescending"
          }
        }
      ]
    },
