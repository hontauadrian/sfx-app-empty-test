      "steps": [
        { "kind": "setAuth", "binding": "admin" },
        { "kind": "api", "transport": "http", "method": "POST", "path": "/brands", "body": { "name": "Voice Bad Body Brand" } },
        { "kind": "expect", "status": 201, "bodyHas": { "$.success": true } },
        { "kind": "capture", "bindings": { "createdBrandId": "$.data.id" } },
        { "kind": "api", "transport": "http", "method": "PUT", "path": "/brands/${createdBrandId}/guidelines/voice", "body": { "tone": "" } },
        { "kind": "expect", "status": 400 }
      ]
    },
    {
      "id": "flow:brands-brandId-guidelines-voice:put:status-reach:404",
      "description": "OVERRIDE generator default. mx-967e12: PUT 404 reach requires VALID body so Zod doesn't 400 first; existence guard fires after Zod, returns 404 on unknown brandId.",
      "contract": {
        "kind": "http",
        "source": "spec-72fd §5 Task B-B2 pipe-then-existence order + mulch mx-967e12",
        "endpoint": "PUT /api/v1/brands/:brandId/guidelines/voice"
      },
      "steps": [
        { "kind": "setAuth", "binding": "admin" },
