        { "kind": "expect", "status": 201, "bodyHas": { "$.success": true } },
        { "kind": "capture", "bindings": { "createdBrandId": "$.data.id" } },
        { "kind": "api", "transport": "http", "method": "GET", "path": "/brands/${createdBrandId}/guidelines/voice" },
        { "kind": "expect", "status": 200, "bodyHas": { "$.success": true } }
