{
  "version": 1,
  "task_id": "_shared",
  "owns": [
    { "actor": "anonymous" },
    { "actor": "admin" },
    { "actor": "viewer" }
  ],
  "actors": [
    {
      "name": "anonymous",
      "auth": { "scheme": "anonymous" }
    },
    {
      "name": "admin",
      "auth": {
        "scheme": "bearer-in-body",
        "login": {
          "path": "${env:OAUTH_ISSUER_URL}/protocol/openid-connect/token",
          "contentType": "application/x-www-form-urlencoded",
          "body": {
            "grant_type": "password",
            "client_id": "${env:OAUTH2_PROXY_CLIENT_ID}",
            "client_secret": "${env:OAUTH2_PROXY_CLIENT_SECRET}",
            "username": "admin@example.com",
            "password": "password",
            "scope": "openid"
          },
          "key": "$.access_token"
        }
      }
    },
    {
      "name": "viewer",
      "auth": {
        "scheme": "bearer-in-body",
        "login": {
          "path": "${env:OAUTH_ISSUER_URL}/protocol/openid-connect/token",
          "contentType": "application/x-www-form-urlencoded",
          "body": {
            "grant_type": "password",
            "client_id": "${env:OAUTH2_PROXY_CLIENT_ID}",
            "client_secret": "${env:OAUTH2_PROXY_CLIENT_SECRET}",
            "username": "viewer@example.com",
            "password": "password",
            "scope": "openid"
          },
          "key": "$.access_token"
        }
      }
    }
  ],
  "config": {
    "reservedActors": {
      "anonymous": {
        "auth": { "scheme": "anonymous" }
      }
    },
    "fixturesRoot": "fixtures",
    "envelope": {
      "successWrapper": ["data"],
      "errorWrapper": ["error"]
    }
  }
}
