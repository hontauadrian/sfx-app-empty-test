{
  "name": "sfx-webapp-boilerplate",
  "private": true,
  "scripts": {
    "prepare": "bash scripts/setup-git-merge-drivers.sh",
    "postinstall": "bash scripts/worktree-stack.sh refresh-watch-if-running",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:migrate:deploy": "pnpm --filter @sfx/database prisma migrate deploy",
    "db:seed": "pnpm --filter @sfx/database prisma db seed",
    "db:studio": "pnpm --filter @sfx/database prisma studio",
    "db:generate": "pnpm --filter @sfx/database prisma generate",
    "test:e2e:browser": "playwright test",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:reload-api": "bash scripts/stack-reload-api.sh",
    "stack:gen-mounts": "node scripts/generate-stack-mounts.mjs",
    "stack:down": "bash scripts/stack-down.sh",
    "env:hydrate": "bash scripts/stack-env-hydrate.sh",
    "stack:start": "bash scripts/worktree-stack.sh start",
    "stack:stop": "bash scripts/worktree-stack.sh stop",
    "stack:reset": "bash scripts/worktree-stack.sh reset",
    "stack:status": "bash scripts/worktree-stack.sh status",
    "stack:ports": "bash scripts/worktree-stack.sh ports",
    "stack:health": "bash scripts/worktree-stack.sh health",
    "stack:refresh-watch": "bash scripts/worktree-stack.sh refresh-watch",
    "stack:logs": "bash scripts/stack-debug-docker.sh logs",
    "stack:follow": "bash scripts/stack-debug-docker.sh follow",
    "stack:ps": "bash scripts/stack-debug-docker.sh ps",
    "stack:bridge": "bash scripts/stack-debug-docker.sh bridge",
    "stack:bridge:tail": "bash scripts/stack-debug-docker.sh bridge -f",
    "stack:debug": "bash scripts/stack-debug-docker.sh status",
    "matrix:regen": "node .overstory/claude-profiles/${PROBE_PROFILE:-builder}/hooks/probes/derive-test-matrix.js",
    "matrix:regen:full": "node .overstory/claude-profiles/${PROBE_PROFILE:-builder}/hooks/probes/derive-test-matrix.js --full",
    "flows:regen": "node .overstory/claude-profiles/${PROBE_PROFILE:-builder}/hooks/probes/flows-generator.js",
    "flows:bootstrap": "pnpm exec tsx .overstory/claude-profiles/${PROBE_PROFILE:-builder}/hooks/probes/contract-flows/bootstrap.ts",
    "probe:matrix": "node .overstory/claude-profiles/builder/hooks/probes/derive-test-matrix.js --verbose",
    "probe:matrix:full": "node .overstory/claude-profiles/builder/hooks/probes/derive-test-matrix.js --full --verbose",
    "probe:matrix:sync": "bash scripts/sync-probe-mirrors.sh",
    "probe:matrix:test": "node .overstory/claude-profiles/builder/hooks/probes/__tests__/derive-test-matrix.test.js",
    "openapi:check": "node scripts/check-openapi-dump.mjs apps/api/.openapi.json",
    "db:reset:fast": "bash scripts/db-reset-fast.sh",
    "probe:smoke": "bash scripts/probe-bootstrap.sh && pnpm openapi:check && pnpm exec tsx .overstory/claude-profiles/${PROBE_PROFILE:-builder}/hooks/probes/http-smoke.ts --matrix .claude/hooks/.matrix.json --report .claude/hooks/.http-smoke.json --human-report .claude/hooks/.http-smoke.md",
    "probe:smoke:full": "bash scripts/probe-bootstrap.sh && pnpm openapi:check && pnpm exec tsx .overstory/claude-profiles/${PROBE_PROFILE:-builder}/hooks/probes/http-smoke.ts --full --matrix .claude/hooks/.matrix.json --report .claude/hooks/.http-smoke.json --human-report .claude/hooks/.http-smoke.md"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@playwright/test": "^1.51.1",
    "@swc-node/register": "1.10.9",
    "@swc/core": "1.13.3",
    "@types/supertest": "6.0.2",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "glob": "11.0.0",
    "prettier": "3.4.2",
    "reflect-metadata": "0.2.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "turbo": "2.5.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "zod": "3.24.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
